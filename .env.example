# === Supabase (backend real) ===
# Si estas variables NO están definidas, Agendik corre en MODO DEMO
# (datos de muestra en el navegador, sin backend).
#
# 1. Creá un proyecto en https://supabase.com
# 2. Corré supabase/migrations/*.sql y supabase/seed.sql en el SQL Editor
# 3. Copiá estos valores desde Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Slug del negocio al que se asocian los registros nuevos (tabla tenants)
VITE_DEFAULT_TENANT=estudio-alma
