{
	admin off
	auto_https off
}

:80 {
	# Rutas de administración de GoTrue: nunca por Internet.
	# OJO: tiene que ser un `handle` y estar primero; con un `respond` suelto, Caddy evalúa antes los `handle`.
	@bloqueadas path /auth/v1/admin /auth/v1/admin/*
	handle @bloqueadas {
		respond 404
	}

	# API pública: autenticación, datos con RLS y funciones. Agendik no usa realtime ni storage.
	@supabase path /auth/v1/* /rest/v1/* /functions/v1/*
	handle @supabase {
		reverse_proxy api-gw:8000 {
			header_up X-Forwarded-For {header.CF-Connecting-IP}
			header_up X-Real-IP {header.CF-Connecting-IP}
		}
	}

	# Todo lo demás es el portal (SPA de Vite): archivos estáticos con salida a index.html.
	handle {
		root * /srv
		encode zstd gzip

		@hasheados path /assets/*
		header @hasheados Cache-Control "public, max-age=31536000, immutable"
		@documento not path /assets/*
		header @documento Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		# Nadie puede mostrar Agendik dentro de otro sitio (clickjacking).
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Todo sale de este servidor salvo el contador de visitas de Cloudflare (sin cookies; ver /cookies).
		# 'unsafe-inline' en estilos: lo necesitan los avisos (react-hot-toast inyecta un <style>) y los style={{}} de React.
		# Probada en modo solo reporte el 22-oct-2026 (sin violaciones) antes de hacerla obligatoria.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
