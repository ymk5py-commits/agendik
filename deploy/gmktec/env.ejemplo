# Agendik (gmktec) — variables del servidor.
# Esta plantilla NO tiene secretos. generar-secretos.sh la copia a «.env» y reemplaza cada
# valor «CAMBIAR» por uno nuevo. El .env real nunca se versiona.

############ Secretos (los genera generar-secretos.sh)
POSTGRES_PASSWORD=CAMBIAR
JWT_SECRET=CAMBIAR
ANON_KEY=CAMBIAR
SERVICE_ROLE_KEY=CAMBIAR
PG_META_CRYPTO_KEY=CAMBIAR
# Acceso a Studio (usuario y clave del panel de Supabase, solo en 127.0.0.1:3211)
DASHBOARD_USERNAME=agendik
DASHBOARD_PASSWORD=CAMBIAR

############ URLs públicas (un solo dominio para el portal y la API)
SUPABASE_PUBLIC_URL=https://agendik.botika.lat
API_EXTERNAL_URL=https://agendik.botika.lat/auth/v1
SITE_URL=https://agendik.botika.lat
ADDITIONAL_REDIRECT_URLS=https://agendik.botika.lat/**

############ Portal (se hornea en el build de la SPA)
# Negocio al que se asocian los registros nuevos que entran por la raíz (tabla tenants.slug).
VITE_DEFAULT_TENANT=estudio-alma

############ Base de datos
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ Auth
JWT_EXPIRY=3600
# Agendik: cada cliente crea su cuenta desde el portal.
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# true mientras no haya SMTP: con confirmación y sin correo, nadie podría entrar.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

############ SMTP de GoTrue (recuperar contraseña, confirmación)
# Sin servidor real: no sale ningún correo hasta cargar uno (Brevo: smtp-relay.brevo.com, 587).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-responder@botika.lat
SMTP_SENDER_NAME="Agendik"

############ Funciones (notificar)
FUNCTIONS_VERIFY_JWT=true
# Mails de aviso de citas (API de Brevo). Vacío = la función falla y la app lo ignora.
BREVO_API_KEY=
BREVO_SENDER=

############ API (PostgREST)
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############ Studio
STUDIO_DEFAULT_ORGANIZATION=Agendik
STUDIO_DEFAULT_PROJECT="Agendik"
